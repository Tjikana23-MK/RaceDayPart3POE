@{ViewData["Title"]="Sign in";}<div class="form-shell"><h1>Welcome back</h1><p class="muted">Sign in to your RaceDay account.</p>@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}<form method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><label>Email</label><input class="form-control mb-3" type="email" name="email" required/><label>Password</label><input class="form-control mb-3" type="password" name="password" required/><button class="btn btn-orange w-100">Sign in</button></form><p class="mt-3">New to RaceDay? <a href="/Account/Register">Create an account</a></p></div>