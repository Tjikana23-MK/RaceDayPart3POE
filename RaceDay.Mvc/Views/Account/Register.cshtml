@{ViewData["Title"]="Register";}<div class="form-shell"><h1>Create account</h1>@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}<form method="post"><label>First name</label><input class="form-control mb-2" name="firstName" required/><label>Last name</label><input class="form-control mb-2" name="lastName" required/><label>Email</label><input class="form-control mb-2" type="email" name="email" required/><label>Phone</label><input class="form-control mb-2" name="phone"/><label>Password (minimum 8 characters)</label><input class="form-control mb-2" type="password" name="password" minlength="8" required/><label>Account type</label><select class="form-select mb-3" name="role"><option>Participant</option><option>Organiser</option></select><button class="btn btn-orange w-100">Create account</button></form></div>