@{ViewData["Title"]="Home";var events=(JsonElement)ViewBag.Events;}<section class="hero"><span class="eyebrow">YOUR NEXT FINISH LINE STARTS HERE</span><h1>Find your pace.<br/><em>Own your race.</em></h1><p>Discover running, walking and cycling events. Register, compete and track every finish.</p><a class="btn btn-orange" href="/Account/Register">Get started</a> <a class="btn btn-outline-light" href="/Account/Login">Sign in</a></section><h2 class="mt-5">Upcoming events</h2><div class="row g-3">@foreach(var e in events.EnumerateArray()){<div class="col-md-4"><div class="card event-card"><div class="card-body"><span class="badge text-bg-primary">@e.GetProperty("eventType").GetString()</span><h4 class="mt-2">@e.GetProperty("name").GetString()</h4><p>@e.GetProperty("location").GetString()</p><p>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy") • @e.GetProperty("distanceKm").ToString() km</p><a class="btn btn-dark" href="/Account/Login">View event</a></div></div></div>}</div>