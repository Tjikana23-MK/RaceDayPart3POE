@{ViewData["Title"]="Categories";var items=(JsonElement)ViewBag.Categories;int id=(int)ViewBag.EventId;}<h1>Event categories</h1><div class="form-shell"><form method="post" action="/Organiser/AddCategory"><input type="hidden" name="eventId" value="@id"/><label>Category name</label><input class="form-control mb-2" name="name" required/><label>Category type</label><select class="form-select mb-2" name="categoryType"><option>Age</option><option>Distance</option></select><label>Minimum age</label><input class="form-control mb-2" type="number" name="minimumAge"/><label>Maximum age</label><input class="form-control mb-2" type="number" name="maximumAge"/><label>Distance km</label><input class="form-control mb-3" type="number" step="0.1" name="distanceKm"/><button class="btn btn-orange">Add category</button></form></div><ul class="list-group mt-3">@foreach(var c in items.EnumerateArray()){<li class="list-group-item">@c.GetProperty("name").GetString() — @c.GetProperty("categoryType").GetString()</li>}</ul>