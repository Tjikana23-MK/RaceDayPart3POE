@{ViewData["Title"]="Enrolments";var items=(JsonElement)ViewBag.Items;}<h1>Event enrolments</h1><table class="table"><thead><tr><th>Participant</th><th>Email</th><th>Category</th><th>Status</th></tr></thead><tbody>@foreach(var x in items.EnumerateArray()){<tr><td>@x.GetProperty("participant").GetString()</td><td>@x.GetProperty("email").GetString()</td><td>@x.GetProperty("category").GetString()</td><td><span class="status">@x.GetProperty("status").GetString()</span></td></tr>}</tbody></table>