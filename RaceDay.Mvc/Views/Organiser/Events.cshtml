@{ViewData["Title"]="Manage events";var events=(JsonElement)ViewBag.Events;var types=(JsonElement)ViewBag.Types;}<h1>Event management</h1><div class="form-shell wide"><h4>Create an event</h4><form method="post" enctype="multipart/form-data" action="/Organiser/CreateEvent"><div class="row g-2"><div class="col-md-6"><label>Event name</label><input class="form-control" name="name" required/></div><div class="col-md-6"><label>Location</label><input class="form-control" name="location" required/></div><div class="col-md-6"><label>Date and time</label><input class="form-control" type="datetime-local" name="eventDate" required/></div><div class="col-md-3"><label>Distance (km)</label><input class="form-control" type="number" step="0.1" name="distanceKm" required/></div><div class="col-md-3"><label>Event type</label><select class="form-select" name="eventTypeId">@foreach(var t in types.EnumerateArray()){<option value="@t.GetProperty("eventTypeId").GetInt32()">@t.GetProperty("name").GetString()</option>}</select></div><div class="col-12"><label>Description</label><textarea class="form-control" name="description" rows="3"></textarea></div><div class="col-12"><label>Event banner (image)</label><input class="form-control" type="file" name="banner" accept="image/*"/></div><div class="col-12"><button class="btn btn-orange">Create event</button></div></div></form></div><h3 class="mt-4">Your events</h3>@foreach(var e in events.EnumerateArray()){<div class="card event-card mb-3"><div class="card-body"><h5>@e.GetProperty("name").GetString()</h5><p>@e.GetProperty("location").GetString() · @e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</p><details class="mb-3"><summary class="text-primary">Edit event details</summary><form method="post" action="/Organiser/UpdateEvent" class="row g-2 mt-2"><input type="hidden" name="id" value="@e.GetProperty("eventId").GetInt32()"/><div class="col-md-6"><input class="form-control" name="name" value="@e.GetProperty("name").GetString()" required/></div><div class="col-md-6"><input class="form-control" name="location" value="@e.GetProperty("location").GetString()" required/></div><div class="col-md-4"><input class="form-control" type="datetime-local" name="eventDate" value="@e.GetProperty("eventDate").GetDateTime().ToString("yyyy-MM-ddTHH:mm")" required/></div><div class="col-md-4"><input class="form-control" type="number" step="0.1" name="distanceKm" value="@e.GetProperty("distanceKm").ToString()" required/></div><div class="col-md-4"><select class="form-select" name="eventTypeId"><option value="1">Run</option><option value="2">Walk</option><option value="3">Cycle</option></select></div><div class="col-12"><textarea class="form-control" name="description">@e.GetProperty("description").GetString()</textarea></div><div class="col-12"><button class="btn btn-sm btn-primary">Save changes</button></div></form></details><div class="d-flex gap-3"><a href="/Organiser/Categories/@e.GetProperty("eventId").GetInt32()">Categories</a><a href="/Organiser/Enrolments/@e.GetProperty("eventId").GetInt32()">Enrolments</a><a href="/Organiser/Results/@e.GetProperty("eventId").GetInt32()">Enter results</a><form method="post" action="/Organiser/DeleteEvent"><input type="hidden" name="id" value="@e.GetProperty("eventId").GetInt32()"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></div></div>}