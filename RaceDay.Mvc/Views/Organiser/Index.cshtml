@{ViewData["Title"]="Organiser dashboard";var events=(JsonElement)ViewBag.Events;var count=events.GetArrayLength();}<span class="eyebrow">ORGANISER CONTROL CENTRE</span><h1>RaceDay dashboard</h1><p>Welcome, @Context.Session.GetString("FirstName"). Manage your events and race-day operations.</p><div class="row g-3 my-3"><div class="col-md-4"><div class="stat"><small>EVENTS CREATED</small><strong>@count</strong></div></div><div class="col-md-4"><div class="stat"><small>UPCOMING EVENTS</small><strong>@events.EnumerateArray().Count(e=>e.GetProperty("eventDate").GetDateTime()>=DateTime.UtcNow)</strong></div></div><div class="col-md-4"><div class="stat"><small>MANAGEMENT</small><strong>Ready</strong></div></div></div><a class="btn btn-orange" href="/Organiser/Events">Manage events</a><div class="row g-3 mt-3">@foreach(var e in events.EnumerateArray()){<div class="col-md-4"><div class="card event-card"><div class="card-body"><h5>@e.GetProperty("name").GetString()</h5><p>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</p><p><strong>@(((Dictionary<int,int>)ViewBag.EnrolmentCounts)[e.GetProperty("eventId").GetInt32()])</strong> enrolments</p><a href="/Organiser/Enrolments/@e.GetProperty("eventId").GetInt32()">Enrolments</a> · <a href="/Organiser/Results/@e.GetProperty("eventId").GetInt32()">Results</a> · <a href="/Organiser/Categories/@e.GetProperty("eventId").GetInt32()">Categories</a></div></div></div>}</div>