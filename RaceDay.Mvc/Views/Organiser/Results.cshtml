@{ViewData["Title"]="Results entry";var items=(JsonElement)ViewBag.Items;int id=(int)ViewBag.EventId;}<h1>Record race results</h1><p>Enter each participant's finish time and finishing position. Saving publishes the result to their personal results page.</p>@foreach(var x in items.EnumerateArray()){<div class="card event-card mb-3"><div class="card-body"><h5>@x.GetProperty("participant").GetString() — @x.GetProperty("category").GetString()</h5><span class="status">@x.GetProperty("status").GetString()</span><form method="post" action="/Organiser/SaveResult" class="row g-2 mt-2"><input type="hidden" name="eventId" value="@id"/><input type="hidden" name="enrolmentId" value="@x.GetProperty("enrolmentId").GetInt32()"/><div class="col-md-5"><label>Finish time (hh:mm:ss)</label><input class="form-control" name="finishTime" placeholder="01:24:35" required/></div><div class="col-md-3"><label>Position</label><input class="form-control" type="number" min="1" name="finishingPosition" required/></div><div class="col-md-4 align-self-end"><button class="btn btn-orange">Save / update result</button></div></form></div></div>}