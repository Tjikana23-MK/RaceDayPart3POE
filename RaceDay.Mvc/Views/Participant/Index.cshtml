@{ViewData["Title"]="Explore events";var events=(JsonElement)ViewBag.Events;}<div class="d-flex justify-content-between align-items-center"><div><span class="eyebrow">PARTICIPANT AREA</span><h1>Upcoming races</h1></div><span class="pill">Welcome, @Context.Session.GetString("FirstName")</span></div><form class="row g-2 mb-4"><div class="col-md-4"><input class="form-control" name="search" placeholder="Search events"/></div><div class="col-md-3"><button class="btn btn-dark">Search</button></div></form><div class="row g-3">@foreach(var e in events.EnumerateArray()){<div class="col-md-4"><div class="card event-card">@if(e.TryGetProperty("bannerUrl",out var b)&&b.ValueKind==JsonValueKind.String&&!string.IsNullOrWhiteSpace(b.GetString())){<img src="@b.GetString()" class="event-card-banner" alt="Event banner"/>}<div class="card-body"><span class="badge bg-primary">@e.GetProperty("eventType").GetString()</span><h4 class="mt-2">@e.GetProperty("name").GetString()</h4><p>@e.GetProperty("location").GetString()</p><p>@e.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy") · @e.GetProperty("distanceKm").ToString() km</p><a class="btn btn-orange" href="/Participant/Details/@e.GetProperty("eventId").GetInt32()">Explore event</a></div></div></div>}</div>