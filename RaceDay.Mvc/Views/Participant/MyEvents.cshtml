@{ViewData["Title"]="My events";var items=(JsonElement)ViewBag.Items;}<h1>My events</h1><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead><tbody>@foreach(var x in items.EnumerateArray()){<tr><td>@x.GetProperty("event").GetString()</td><td>@x.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@x.GetProperty("category").GetString()</td><td><span class="status">@x.GetProperty("status").GetString()</span></td></tr>}</tbody></table></div>