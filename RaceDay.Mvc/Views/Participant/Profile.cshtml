@{ViewData["Title"]="My profile";var p=(JsonElement)ViewBag.Profile;}<h1>My profile</h1>@if(p.TryGetProperty("profileImageUrl",out var pic)&&pic.ValueKind==JsonValueKind.String&&!string.IsNullOrWhiteSpace(pic.GetString())){<img src="@pic.GetString()" class="profile-pic" alt="Profile picture"/>}<div class="form-shell"><form method="post" action="/Participant/UpdateProfile"><label>First name</label><input class="form-control mb-2" name="firstName" value="@p.GetProperty("firstName").GetString()" required/><label>Last name</label><input class="form-control mb-2" name="lastName" value="@p.GetProperty("lastName").GetString()" required/><label>Email</label><input class="form-control mb-2" name="email" type="email" value="@p.GetProperty("email").GetString()"/><label>Phone</label><input class="form-control mb-3" name="phone" value="@(p.TryGetProperty("phone",out var ph)?ph.ToString():"")"/><button class="btn btn-orange">Save profile</button></form><hr/><h5>Profile picture</h5><form method="post" enctype="multipart/form-data" action="/Participant/UploadProfile"><input type="file" class="form-control mb-2" name="file" accept="image/*" required/><button class="btn btn-dark">Upload picture</button></form></div>