@{ViewData["Title"]="My results";var items=(JsonElement)ViewBag.Items;}<h1>My race results</h1><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var x in items.EnumerateArray()){<tr><td>@x.GetProperty("event").GetString()</td><td>@x.GetProperty("eventDate").GetDateTime().ToString("dd MMM yyyy")</td><td>@x.GetProperty("category").GetString()</td><td>@x.GetProperty("finishTime").ToString()</td><td>@x.GetProperty("finishingPosition").ToString()</td></tr>}</tbody></table></div>