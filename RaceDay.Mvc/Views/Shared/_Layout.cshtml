<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-expand-lg navbar-dark"><div class="container"><a class="navbar-brand fw-bold" href="/">🏁 RACEDAY</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div id="nav" class="collapse navbar-collapse"><ul class="navbar-nav ms-auto">@if(Context.Session.GetString("Role")=="Organiser"){<li class="nav-item"><a class="nav-link" href="/Organiser">Dashboard</a></li><li class="nav-item"><a class="nav-link" href="/Organiser/Events">Events</a></li>}else if(Context.Session.GetString("Role")=="Participant"){<li class="nav-item"><a class="nav-link" href="/Participant">Explore</a></li><li class="nav-item"><a class="nav-link" href="/Participant/MyEvents">My Events</a></li><li class="nav-item"><a class="nav-link" href="/Participant/Results">My Results</a></li><li class="nav-item"><a class="nav-link" href="/Participant/Profile">Profile</a></li>}else{<li class="nav-item"><a class="nav-link" href="/Account/Login">Login</a></li><li class="nav-item"><a class="nav-link" href="/Account/Register">Register</a></li>}@if(Context.Session.GetString("ApiCookie")!=null){<li class="nav-item"><a class="nav-link" href="/Account/Logout">Logout</a></li>}</ul></div></div></nav><main class="container py-4">@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-warning">@TempData["Error"]</div>}@RenderBody()</main><footer class="text-center py-4">RACEDAY • Run your race. Own your journey.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>